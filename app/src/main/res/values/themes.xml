<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Day theme: light with lime accent -->
    <style name="Theme.Suruhaja" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/brand_dark</item>
        <item name="colorAccent">@color/accent_blue</item>
        <item name="android:colorBackground">@color/surface_high</item>
        <item name="android:statusBarColor">@color/surface_high</item>
        <item name="android:navigationBarColor">@color/surface_high</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>
    </style>

    <style name="BentoTile">
        <item name="android:background">@drawable/bg_bento_tile</item>
        <item name="android:padding">16dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="ButtonPrimary" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/brand</item>
        <item name="android:textColor">@color/text_on_brand</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <style name="CustomDialog" parent="Theme.Material3.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <style name="App.Custom.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/brand</item>
    </style>

    <style name="NavLabelActive">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
    </style>

    <style name="NavLabelInactive">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>

    <!-- SuruhSend form styles -->
    <style name="SendLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/brand_ink</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">@font/poppins_black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="SendInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_profile_sheet_input</item>
        <item name="android:textColor">@color/brand_ink</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="SendSectionHeader">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#2FA85B</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/poppins_black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>
</resources>
