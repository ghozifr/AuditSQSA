<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="104dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_activity_history_card"
    android:paddingStart="22dp"
    android:paddingTop="14dp"
    android:paddingEnd="22dp"
    android:paddingBottom="14dp">

    <ImageView
        android:id="@+id/iv_item_service"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_activity_icon_well"
        android:contentDescription="Jenis layanan"
        android:padding="14dp"
        android:src="@drawable/ic_asset_drive_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_item_destination"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/brand_ink"
        android:textSize="16sp"
        android:fontFamily="@font/poppins_bold"
        app:layout_constraintEnd_toStartOf="@id/tv_item_price"
        app:layout_constraintStart_toEndOf="@id/iv_item_service"
        app:layout_constraintTop_toTopOf="@id/iv_item_service" />

    <TextView
        android:id="@+id/tv_item_status"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_activity_cancelled_chip"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:textColor="@color/brand_ink"
        android:textSize="11sp"
        android:fontFamily="@font/poppins_bold"
        app:layout_constraintStart_toStartOf="@id/tv_item_destination"
        app:layout_constraintTop_toBottomOf="@id/tv_item_destination" />

    <TextView
        android:id="@+id/tv_item_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textColor="@color/brand_ink"
        android:textSize="16sp"
        android:fontFamily="@font/poppins_bold"
        android:textStyle="bold"
        app:layout_constraintBaseline_toBaselineOf="@id/tv_item_destination"
        app:layout_constraintEnd_toStartOf="@id/tv_item_chevron" />

    <TextView
        android:id="@+id/tv_item_chevron"
        android:layout_width="20dp"
        android:layout_height="28dp"
        android:layout_marginStart="10dp"
        android:gravity="center"
        android:text="›"
        android:textColor="@color/brand_ink"
        android:textSize="32sp"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toBottomOf="@id/tv_item_status"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_item_status" />
</androidx.constraintlayout.widget.ConstraintLayout>
