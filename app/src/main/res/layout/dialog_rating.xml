<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_activity_history_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="22dp">
    <TextView android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/bg_activity_stat_amber" android:gravity="center" android:text="★" android:textColor="@color/brand_ink" android:textSize="28sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:fontFamily="@font/poppins_black" android:text="Bagaimana driver kamu?" android:textColor="@color/brand_ink" android:textSize="20sp" android:textStyle="bold" />
    <TextView android:id="@+id/tv_rating_driver_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:fontFamily="@font/poppins_black" android:text="Nama driver" android:textColor="@color/brand_ink" android:textSize="14sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:fontFamily="@font/poppins_bold" android:gravity="center" android:text="Pilih bintang untuk pengalaman perjalananmu." android:textColor="@color/text_muted" android:textSize="12sp" android:textStyle="bold" />
    <RatingBar android:id="@+id/rating_bar_dialog" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:numStars="5" android:progressBackgroundTint="@color/text_muted" android:progressTint="@color/amber" android:rating="5" android:secondaryProgressTint="@android:color/transparent" android:stepSize="1.0" />
    <TextView android:clickable="true" android:focusable="true" android:gravity="center" android:id="@+id/btn_submit_rating" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="22dp" android:background="@drawable/bg_location_primary_teal" android:fontFamily="@font/poppins_black" android:text="Kirim rating" android:textAllCaps="false" android:textColor="@color/brand_ink" android:textSize="14sp" />
    <TextView android:id="@+id/btn_skip_rating" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:background="@drawable/bg_activity_icon_well" android:clickable="true" android:focusable="true" android:fontFamily="@font/poppins_black" android:gravity="center" android:text="Nanti saja" android:textColor="@color/brand_ink" android:textSize="13sp" android:textStyle="bold" />
</LinearLayout>
