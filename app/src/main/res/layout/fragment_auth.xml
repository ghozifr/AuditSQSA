<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_lavender"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Keep this as first child: AuthFragment applies status-bar height here. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="#A78BFA"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="18dp">
            <ImageView
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:background="@drawable/bg_activity_history_card"
                android:padding="12dp"
                android:src="@drawable/ic_logo_small" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/poppins_black"
                android:text="SURUH AJA"
                android:textColor="@color/brand_ink"
                android:textSize="27sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="Semua kebutuhan, satu aplikasi"
                android:textColor="#4A3C71"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp"
            android:paddingBottom="42dp">

            <!-- Daftar / Masuk state -->
            <LinearLayout
                android:id="@+id/layout_credentials_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_activity_history_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tv_card_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_black"
                    android:text="Daftar"
                    android:textColor="@color/brand_ink"
                    android:textSize="23sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_card_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="22dp"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Buat akun baru dengan email"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:fontFamily="@font/poppins_black" android:letterSpacing="0.12" android:text="EMAIL" android:textColor="@color/brand_ink" android:textSize="10sp" android:textStyle="bold" />
                <EditText
                    android:id="@+id/et_email"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="18dp"
                    android:background="@drawable/bg_profile_sheet_input"
                    android:fontFamily="@font/poppins_bold"
                    android:hint="nama@email.com"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/brand_ink"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:fontFamily="@font/poppins_black" android:letterSpacing="0.12" android:text="PASSWORD" android:textColor="@color/brand_ink" android:textSize="10sp" android:textStyle="bold" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginBottom="18dp">
                    <EditText
                        android:id="@+id/et_password"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_profile_sheet_input"
                        android:fontFamily="@font/poppins_bold"
                        android:hint="Minimal 6 karakter"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:paddingStart="16dp"
                        android:paddingEnd="56dp"
                        android:textColor="@color/brand_ink"
                        android:textColorHint="@color/text_muted"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <ImageButton
                        android:id="@+id/btn_toggle_password"
                        android:layout_width="52dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="end"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Tampilkan password"
                        android:padding="14dp"
                        android:src="@drawable/ic_eye"
                        app:tint="@color/brand_ink" />
                </FrameLayout>

                <LinearLayout android:id="@+id/layout_confirm_password" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:fontFamily="@font/poppins_black" android:letterSpacing="0.12" android:text="KONFIRMASI PASSWORD" android:textColor="@color/brand_ink" android:textSize="10sp" android:textStyle="bold" />
                    <FrameLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginBottom="18dp">
                        <EditText
                            android:id="@+id/et_confirm_password"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_profile_sheet_input"
                            android:fontFamily="@font/poppins_bold"
                            android:hint="Ketik ulang password"
                            android:imeOptions="actionDone"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:paddingStart="16dp"
                            android:paddingEnd="56dp"
                            android:textColor="@color/brand_ink"
                            android:textColorHint="@color/text_muted"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <ImageButton
                            android:id="@+id/btn_toggle_confirm_password"
                            android:layout_width="52dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="end"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Tampilkan konfirmasi password"
                            android:padding="14dp"
                            android:src="@drawable/ic_eye"
                            app:tint="@color/brand_ink" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Kode referral (opsional, hanya saat daftar). Server yang memutuskan sah/tidak. -->
                <LinearLayout android:id="@+id/layout_referral_code" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:fontFamily="@font/poppins_black" android:letterSpacing="0.12" android:text="KODE REFERRAL (OPSIONAL)" android:textColor="@color/brand_ink" android:textSize="10sp" android:textStyle="bold" />
                    <EditText
                        android:id="@+id/et_referral_code"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_profile_sheet_input"
                        android:fontFamily="@font/poppins_black"
                        android:hint="Mis. S7K3M9"
                        android:imeOptions="actionDone"
                        android:inputType="textCapCharacters|textNoSuggestions"
                        android:letterSpacing="0.08"
                        android:maxLength="12"
                        android:maxLines="1"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/brand_ink"
                        android:textColorHint="@color/text_muted"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_marginBottom="18dp" android:fontFamily="@font/poppins_bold" android:text="Punya kode dari teman? Isi sekali saja saat mendaftar — kamu dapat voucher gratis ongkir setelah order SuruhFood pertama." android:textColor="@color/text_muted" android:textSize="10sp" android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_forgot_password"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/poppins_bold"
                    android:padding="4dp"
                    android:text="Lupa password?"
                    android:textColor="@color/brand_ink"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/btn_submit"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_activity_stat_teal"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/tv_btn_submit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_black"
                        android:text="Daftar"
                        android:textColor="@color/brand_ink"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_toggle_mode"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_activity_icon_well"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="center"
                    android:text="Sudah punya akun? Masuk"
                    android:textColor="@color/brand_ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- New-user profile completion state -->
            <LinearLayout
                android:id="@+id/layout_name_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_activity_history_card"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/poppins_black" android:text="Selamat datang!" android:textColor="@color/brand_ink" android:textSize="23sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:layout_marginBottom="22dp" android:fontFamily="@font/poppins_bold" android:text="Lengkapi profil kamu dulu ya" android:textColor="@color/text_muted" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:fontFamily="@font/poppins_black" android:letterSpacing="0.12" android:text="NAMA LENGKAP" android:textColor="@color/brand_ink" android:textSize="10sp" android:textStyle="bold" />
                <EditText android:id="@+id/et_name" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginBottom="18dp" android:background="@drawable/bg_profile_sheet_input" android:fontFamily="@font/poppins_bold" android:hint="Nama kamu" android:inputType="textPersonName" android:paddingHorizontal="16dp" android:textColor="@color/brand_ink" android:textColorHint="@color/text_muted" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:fontFamily="@font/poppins_black" android:letterSpacing="0.12" android:text="NOMOR HP" android:textColor="@color/brand_ink" android:textSize="10sp" android:textStyle="bold" />
                <EditText android:id="@+id/et_phone" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginBottom="22dp" android:background="@drawable/bg_profile_sheet_input" android:fontFamily="@font/poppins_bold" android:hint="0812 3456 7890" android:inputType="phone" android:maxLength="14" android:paddingHorizontal="16dp" android:textColor="@color/brand_ink" android:textColorHint="@color/text_muted" android:textSize="14sp" android:textStyle="bold" />
                <LinearLayout android:id="@+id/btn_save_name" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/bg_activity_stat_teal" android:clickable="true" android:focusable="true" android:gravity="center"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/poppins_black" android:text="Simpan profil" android:textColor="@color/brand_ink" android:textSize="15sp" android:textStyle="bold" /></LinearLayout>
            </LinearLayout>

            <!-- Verifikasi email: kode OTP 6 digit dikirim ke email akun -->
            <LinearLayout
                android:id="@+id/layout_otp_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_activity_history_card"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/poppins_black" android:text="Verifikasi email" android:textColor="@color/brand_ink" android:textSize="23sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_otp_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:layout_marginBottom="18dp" android:fontFamily="@font/poppins_bold" android:text="Kami kirim kode 6 digit ke email kamu" android:textColor="@color/text_muted" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:fontFamily="@font/poppins_black" android:letterSpacing="0.12" android:text="KODE DARI EMAIL" android:textColor="@color/brand_ink" android:textSize="10sp" android:textStyle="bold" />
                <EditText android:id="@+id/et_otp" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginBottom="8dp" android:background="@drawable/bg_profile_sheet_input" android:fontFamily="@font/poppins_black" android:gravity="center" android:hint="······" android:imeOptions="actionDone" android:inputType="number" android:letterSpacing="0.4" android:maxLength="6" android:textColor="@color/brand_ink" android:textColorHint="@color/text_muted" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_otp_dev_code" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:background="@drawable/bg_activity_cancelled_chip" android:gravity="center" android:padding="10dp" android:textColor="@color/brand_ink" android:textSize="12sp" android:textStyle="bold" android:visibility="gone" />
                <LinearLayout android:id="@+id/btn_verify_otp" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/bg_activity_stat_teal" android:clickable="true" android:focusable="true" android:gravity="center"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/poppins_black" android:text="Verifikasi" android:textColor="@color/brand_ink" android:textSize="15sp" android:textStyle="bold" /></LinearLayout>
                <TextView android:id="@+id/btn_resend_otp" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="12dp" android:background="@drawable/bg_activity_icon_well" android:clickable="true" android:focusable="true" android:fontFamily="@font/poppins_bold" android:gravity="center" android:text="Kirim ulang kode" android:textColor="@color/brand_ink" android:textSize="13sp" android:textStyle="bold" />
                <!-- Tombol "Nanti saja" (btn_skip_otp) DIHAPUS: verifikasi OTP wajib
                     diselesaikan sebelum masuk aplikasi. -->

            </LinearLayout>

            <TextView
                android:id="@+id/tv_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_activity_cancelled_chip"
                android:gravity="center"
                android:padding="12dp"
                android:textColor="@color/brand_ink"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
