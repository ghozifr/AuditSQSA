<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_lavender">

    <FrameLayout
        android:id="@+id/map_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/status_card"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/btn_back_tracking"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_activity_history_card"
        android:elevation="10dp"
        android:padding="11dp"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/status_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_location_picker_sheet"
        android:elevation="18dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <View
            android:layout_width="46dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="13dp"
            android:background="@color/black" />

        <include
            android:id="@+id/stepper"
            layout="@layout/layout_phase_stepper" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_order_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_black"
                    android:maxLines="1"
                    android:text="Mencari driver..."
                    android:textColor="@color/brand_ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_order_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_bold"
                    android:maxLines="1"
                    android:text="Mohon tunggu sebentar"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <TextView
                android:id="@+id/tv_price"
                android:layout_width="108dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_activity_stat_teal"
                android:fontFamily="@font/poppins_black"
                android:gravity="center"
                android:text="Rp 0"
                android:textColor="@color/brand_ink"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_driver_info"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_activity_history_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone">
            <FrameLayout
                android:layout_width="50dp"
                android:layout_height="50dp">
                <TextView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_activity_icon_well"
                    android:gravity="center"
                    android:text="🏍"
                    android:textSize="23sp" />
                <ImageView
                    android:id="@+id/iv_driver_photo"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_activity_icon_well"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:id="@+id/tv_driver_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="@font/poppins_black" android:maxLines="1" android:textColor="@color/brand_ink" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_driver_vehicle" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="@font/poppins_bold" android:maxLines="1" android:textColor="@color/text_muted" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/tv_distance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/poppins_black" android:text="—" android:textColor="@color/brand_ink" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_driver_actions"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView
                android:id="@+id/btn_chat_driver"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="7dp"
                android:layout_weight="1"
                android:background="@drawable/bg_activity_history_card"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/poppins_black"
                android:gravity="center"
                android:text="Chat"
                android:textColor="@color/brand_ink"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/btn_call_driver"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:background="@drawable/bg_location_primary_teal"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/poppins_black"
                android:gravity="center"
                android:text="WhatsApp"
                android:textColor="@color/brand_ink"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Jalan masuk manual ke pembayaran. Muncul selama driver sudah minta
             bayar dan order belum lunas — supaya customer tidak stuck ketika
             dialog pembayaran tertutup (tombol back / swipe). Ditaruh SEBELUM
             tombol batal supaya aksi utama lebih dulu. -->
        <TextView
            android:id="@+id/btn_pay_now"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_location_primary_teal"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/poppins_black"
            android:gravity="center"
            android:text="BAYAR SEKARANG"
            android:textColor="@color/brand_ink"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_cancel_order"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_location_primary_coral"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/poppins_black"
            android:gravity="center"
            android:text="Batalkan pesanan"
            android:textColor="@color/brand_ink"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
