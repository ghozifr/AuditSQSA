<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_activity_history_card"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_black"
            android:text="Beri Rating"
            android:textColor="@color/brand_ink"
            android:textSize="19sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/poppins_bold"
            android:text="Toko"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_rating_merchant_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_black"
            android:text="..."
            android:textColor="@color/brand_ink"
            android:textSize="14sp" />

        <RatingBar
            android:id="@+id/rb_merchant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:numStars="5"
            android:progressBackgroundTint="@color/text_muted"
            android:progressTint="@color/amber"
            android:rating="5"
            android:stepSize="1.0" />

        <EditText
            android:id="@+id/et_merchant_comment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_profile_sheet_input"
            android:fontFamily="@font/poppins_bold"
            android:hint="Komentar toko (opsional)"
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:textColor="@color/brand_ink"
            android:textColorHint="@color/text_muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/poppins_bold"
            android:text="Driver"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_rating_driver_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_black"
            android:text="..."
            android:textColor="@color/brand_ink"
            android:textSize="14sp" />

        <RatingBar
            android:id="@+id/rb_driver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:numStars="5"
            android:progressBackgroundTint="@color/text_muted"
            android:progressTint="@color/amber"
            android:rating="5"
            android:stepSize="1.0" />

        <EditText
            android:id="@+id/et_driver_comment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_profile_sheet_input"
            android:fontFamily="@font/poppins_bold"
            android:hint="Komentar driver (opsional)"
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:textColor="@color/brand_ink"
            android:textColorHint="@color/text_muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/poppins_bold"
            android:text="Menu"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/menu_rating_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView android:clickable="true" android:focusable="true" android:gravity="center"
            android:id="@+id/btn_submit"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_food_primary_orange"
            android:fontFamily="@font/poppins_black"
            android:text="Kirim Rating"
            android:textAllCaps="false"
            android:textColor="@color/brand_ink"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_skip"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_activity_icon_well"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/poppins_black"
            android:gravity="center"
            android:text="Nanti Saja (rating 5)"
            android:textColor="@color/brand_ink"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
