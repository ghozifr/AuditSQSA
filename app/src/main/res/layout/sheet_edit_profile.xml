<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/brand_lavender"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="14dp"
    android:paddingEnd="22dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="46dp"
        android:layout_height="5dp"
        android:layout_gravity="center"
        android:layout_marginBottom="20dp"
        android:background="@color/black" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_activity_history_card"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_black"
                    android:text="Edit profil"
                    android:textColor="@color/brand_ink"
                    android:textSize="23sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Perbarui data akun kamu"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_activity_stat_teal"
                android:gravity="center"
                android:text="✎"
                android:textColor="@color/brand_ink"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/poppins_black"
            android:letterSpacing="0.12"
            android:text="NAMA LENGKAP"
            android:textColor="@color/brand_ink"
            android:textSize="10sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_edit_name"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_profile_sheet_input"
            android:fontFamily="@font/poppins_bold"
            android:hint="Nama kamu"
            android:inputType="textPersonName"
            android:paddingHorizontal="16dp"
            android:textColor="@color/brand_ink"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/poppins_black"
            android:letterSpacing="0.12"
            android:text="NOMOR HP"
            android:textColor="@color/brand_ink"
            android:textSize="10sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_edit_phone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:alpha="0.72"
            android:background="@drawable/bg_profile_sheet_input"
            android:enabled="false"
            android:fontFamily="@font/poppins_bold"
            android:hint="+62 812-3456-7890"
            android:inputType="phone"
            android:paddingHorizontal="16dp"
            android:textColor="@color/brand_ink"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/poppins_bold"
            android:text="Nomor HP tidak dapat diubah"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="26dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/btn_save_profile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_activity_stat_teal"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/poppins_black"
                android:gravity="center"
                android:text="Simpan"
                android:textColor="@color/brand_ink"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/btn_cancel_edit"
                android:layout_width="112dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_activity_history_card"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/poppins_black"
                android:gravity="center"
                android:text="Batal"
                android:textColor="@color/brand_ink"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
