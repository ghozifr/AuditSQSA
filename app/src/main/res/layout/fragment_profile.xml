<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_lavender"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="96dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_black"
            android:text="Profil"
            android:textColor="@color/brand_ink"
            android:textSize="25sp"  android:textStyle="bold" />

        <!-- Profile hero: port of iPhone ProfileScreen hero. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_activity_history_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <TextView
                android:id="@+id/tv_profile_initial"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:paddingRight="3dp"
                android:background="@drawable/bg_activity_stat_teal"
                android:gravity="center"
                android:text="P"
                android:textColor="@color/brand_ink"
                android:textSize="30sp"
                android:fontFamily="@font/poppins_black"  android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/poppins_black" android:text="PROFIL KAMU" android:textColor="@color/text_muted" android:textSize="10sp" android:letterSpacing="0.12"  android:textStyle="bold" />
                <TextView android:id="@+id/tv_profile_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:fontFamily="@font/poppins_black" android:text="Pengguna" android:textColor="@color/brand_ink" android:textStyle="bold" android:textSize="22sp" />
                <TextView android:id="@+id/tv_profile_phone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="1" android:fontFamily="@font/poppins_bold" android:text="-" android:textColor="@color/text_muted" android:textSize="12sp"  android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_member_since"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_activity_icon_well"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:text="Member sejak -"
            android:textColor="@color/brand_ink"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_bold"  android:textStyle="bold" />

        <!-- Wallet and points cards. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="154dp"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/card_profile_balance"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_activity_stat_blue"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_activity_history_card" android:paddingRight="3dp" android:paddingBottom="3dp" android:gravity="center" android:text="Rp" android:textColor="@color/brand_ink" android:textSize="11sp" android:fontFamily="@font/poppins_black"  android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="SALDO" android:textColor="#234C62" android:textSize="10sp" android:fontFamily="@font/poppins_black"  android:textStyle="bold" />
                <TextView android:id="@+id/tv_profile_balance" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:text="Rp 0" android:textStyle="bold" android:textColor="@color/brand_ink" android:textSize="17sp" android:fontFamily="@font/poppins_black" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Top up ›" android:textColor="@color/brand_ink" android:textSize="12sp" android:textStyle="italic|bold" android:fontFamily="@font/poppins_bold" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_activity_stat_amber"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView android:layout_width="36dp" android:paddingRight="5dp" android:paddingBottom="5dp" android:layout_height="36dp" android:background="@drawable/bg_activity_history_card" android:gravity="center" android:text="★" android:textColor="@color/brand_ink" android:textSize="19sp" android:fontFamily="@font/poppins_black"  android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="POIN" android:textColor="#5E4420" android:textSize="10sp" android:fontFamily="@font/poppins_black"  android:textStyle="bold" />
                <TextView android:id="@+id/tv_profile_points" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:text="0 pts" android:textColor="@color/brand_ink" android:textSize="17sp" android:textStyle="bold" android:fontFamily="@font/poppins_black" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Reward soon" android:textColor="#5E4420" android:textSize="12sp" android:textStyle="italic|bold" android:fontFamily="@font/poppins_bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Profile data card. -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/bg_activity_history_card" android:orientation="vertical" android:padding="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:textStyle="bold" android:layout_height="wrap_content" android:text="Data profil" android:textColor="@color/brand_ink" android:textSize="20sp" android:fontFamily="@font/poppins_black" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nama dan nomor yang dipakai di aplikasi." android:textColor="@color/text_muted" android:textSize="12sp"  android:textStyle="bold" />
                </LinearLayout>
                <TextView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_activity_icon_well" android:gravity="center" android:text="✎" android:textColor="@color/brand_ink" android:textSize="21sp"  android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/btn_my_vouchers" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/bg_activity_icon_well" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:text="Voucher saya                                      ›" android:textColor="@color/brand_ink" android:textSize="14sp" android:fontFamily="@font/poppins_bold" android:textStyle="bold" />
            <TextView android:id="@+id/btn_edit_profile" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="18dp" android:background="@drawable/bg_activity_icon_well" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:text="Edit profil                                      ›" android:textColor="@color/brand_ink" android:textSize="14sp" android:fontFamily="@font/poppins_bold"  android:textStyle="bold" />
        </LinearLayout>

        <!-- Account info and preserved theme control. -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/bg_activity_history_card" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Info akun" android:textStyle="bold" android:textColor="@color/brand_ink" android:textSize="20sp" android:fontFamily="@font/poppins_black" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="16dp" android:background="@drawable/bg_activity_icon_well" android:gravity="center_vertical" android:paddingHorizontal="14dp" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Nomor HP" android:textColor="@color/text_muted" android:textSize="13sp" android:fontFamily="@font/poppins_bold" android:textStyle="bold" /><TextView android:id="@+id/tv_info_phone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="@color/brand_ink" android:textSize="13sp" android:fontFamily="@font/poppins_black" android:textStyle="bold" /></LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/bg_activity_icon_well" android:gravity="center_vertical" android:paddingHorizontal="14dp" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Bergabung" android:textColor="@color/text_muted" android:textSize="13sp" android:fontFamily="@font/poppins_bold" android:textStyle="bold" /><TextView android:id="@+id/tv_info_joined" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="@color/brand_ink" android:textSize="13sp" android:fontFamily="@font/poppins_black" android:textStyle="bold" /></LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/bg_activity_icon_well" android:gravity="center_vertical" android:paddingHorizontal="14dp" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Email" android:textColor="@color/text_muted" android:textSize="13sp" android:fontFamily="@font/poppins_bold" android:textStyle="bold" /><TextView android:id="@+id/tv_info_email" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="middle" android:maxWidth="200dp" android:singleLine="true" android:text="-" android:textColor="@color/brand_ink" android:textSize="13sp" android:fontFamily="@font/poppins_black" android:textStyle="bold" /></LinearLayout>
            <TextView android:id="@+id/tv_email_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/bg_activity_cancelled_chip" android:gravity="center" android:padding="10dp" android:text="Email belum terverifikasi. Keluar lalu masuk lagi untuk memasukkan kode verifikasi." android:textColor="@color/brand_ink" android:textSize="11sp" android:textStyle="bold" android:visibility="gone" />
            <LinearLayout android:id="@+id/btn_theme_toggle" android:visibility="gone" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/bg_activity_icon_well" android:gravity="center_vertical" android:paddingHorizontal="14dp" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Tema gelap" android:textColor="@color/brand_ink" android:textSize="13sp" android:fontFamily="@font/poppins_bold" android:textStyle="bold" /><androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_theme" android:layout_width="wrap_content" android:layout_height="wrap_content" /></LinearLayout>
        </LinearLayout>

        <TextView android:id="@+id/btn_sign_out" android:layout_width="match_parent" android:layout_height="56dp" android:textStyle="bold" android:layout_marginTop="20dp" android:background="@drawable/bg_activity_history_card" android:gravity="center" android:text="Keluar" android:textColor="@color/red_dark" android:textSize="15sp" android:fontFamily="@font/poppins_black" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:text="✦  SURUH AJA" android:textColor="@color/text_muted" android:textSize="11sp" android:letterSpacing="0.16" android:fontFamily="@font/poppins_black"  android:textStyle="bold" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
