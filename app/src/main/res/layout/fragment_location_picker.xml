<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_lavender"
    tools:ignore="HardcodedText,ContentDescription">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/map_view"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Pending candidate only: explicit confirmation below commits it. -->
        <ImageView
            android:id="@+id/iv_center_pin"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:elevation="9dp"
            android:src="@drawable/ic_map_pin_web_coral"
            android:translationY="-196dp" />
        <TextView
            android:id="@+id/btn_set_destination"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_location_primary_coral"
            android:clickable="true"
            android:elevation="10dp"
            android:focusable="true"
            android:fontFamily="@font/poppins_black"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:text="Konfirmasi tujuan"
            android:textColor="@color/brand_ink"
            android:textSize="13sp"
            android:textStyle="bold"
            android:translationY="-258dp" />
    </FrameLayout>

    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_margin="20dp"
        android:background="@drawable/bg_activity_history_card"
        android:elevation="10dp"
        android:padding="11dp"
        android:src="@drawable/ic_back" />

    <FrameLayout
        android:id="@+id/bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_location_picker_sheet"
        android:elevation="16dp"
        app:behavior_fitToContents="true"
        app:behavior_hideable="false"
        app:behavior_peekHeight="358dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/location_sheet_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="104dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="14dp"
                android:paddingEnd="20dp">

                <View
                    android:layout_width="46dp"
                    android:layout_height="5dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="16dp"
                    android:background="@color/black" />

                <TextView
                    android:id="@+id/tv_picker_step"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_black"
                    android:text="1/2 · Tentukan tujuan"
                    android:textColor="@color/brand_ink"
                    android:textSize="21sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_picker_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Cari alamat atau geser peta, lalu konfirmasi titiknya."
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                                android:id="@+id/layout_location_search"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:layout_marginTop="16dp"
                    android:background="@drawable/bg_profile_sheet_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp">
                    <EditText
                        android:id="@+id/et_location_search"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/poppins_bold"
                        android:hint="Cari tujuan"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingEnd="4dp"
                        android:textColor="@color/brand_ink"
                        android:textColorHint="@color/text_muted"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/btn_search_location"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/bg_activity_stat_teal"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/poppins_black"
                        android:gravity="center"
                        android:text="⌕"
                        android:textColor="@color/brand_ink"
                        android:textSize="25sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_search_suggestions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <!-- Only the active stage is emphasized. Rows remain explicit edit controls at checkout. -->
                <LinearLayout
                    android:id="@+id/row_destination"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_activity_icon_well"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">
                    <View android:layout_width="10dp" android:layout_height="10dp" android:layout_marginEnd="12dp" android:background="@drawable/bg_dot_notif" android:backgroundTint="@color/coral" />
                    <TextView android:id="@+id/tv_dest_address" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:fontFamily="@font/poppins_bold" android:maxLines="1" android:text="Tentukan tujuan" android:textColor="@color/brand_ink" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/poppins_black" android:text="›" android:textColor="@color/brand_ink" android:textSize="22sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/row_pickup"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_activity_icon_well"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="7dp"
                    android:visibility="gone">
                    <View android:layout_width="10dp" android:layout_height="10dp" android:layout_marginEnd="12dp" android:background="@drawable/bg_dot_green" />
                    <TextView android:id="@+id/tv_pickup_address" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:fontFamily="@font/poppins_bold" android:maxLines="1" android:text="Tentukan titik jemput" android:textColor="@color/brand_ink" android:textSize="13sp" android:textStyle="bold" />
                    <ImageView android:id="@+id/btn_my_location" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_activity_history_card" android:padding="10dp" android:src="@drawable/ic_my_location" app:tint="@color/brand_ink" />
                </LinearLayout>

                <!-- Checkout only: route price/payment are not visible during point selection. -->
                <LinearLayout
                    android:id="@+id/layout_estimate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <LinearLayout android:layout_width="0dp" android:layout_height="82dp" android:layout_marginEnd="7dp" android:layout_weight="1" android:background="@drawable/bg_activity_stat_teal" android:gravity="center" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/poppins_black" android:text="TOTAL HARGA" android:textColor="@color/brand_ink" android:textSize="10sp" android:textStyle="bold" />
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical">
                            <TextView android:id="@+id/tv_estimate_price" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/poppins_black" android:text="Rp -" android:textColor="@color/brand_ink" android:textSize="18sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tv_estimate_price_after" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFamily="@font/poppins_black" android:textColor="@color/brand_ink" android:textSize="18sp" android:textStyle="bold" android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="82dp" android:layout_marginStart="7dp" android:layout_weight="1" android:background="@drawable/bg_activity_history_card" android:gravity="center" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/poppins_black" android:text="JARAK" android:textColor="@color/brand_ink" android:textSize="10sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tv_estimate_dist" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/poppins_black" android:text="- km" android:textColor="@color/brand_ink" android:textSize="16sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Tombol voucher: tepat di bawah total harga. -->
                <TextView
                    android:id="@+id/btn_voucher"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_activity_icon_well"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/poppins_black"
                    android:gravity="center"
                    android:text="🎟️  Pakai voucher"
                    android:textColor="@color/brand_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layout_payment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="20dp"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:fontFamily="@font/poppins_black" android:text="PILIH PEMBAYARAN" android:textColor="@color/brand_ink" android:textSize="10sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal">
                        <TextView android:id="@+id/btn_pay_cash" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="7dp" android:layout_weight="1" android:background="@drawable/bg_activity_history_card" android:clickable="true" android:focusable="true" android:fontFamily="@font/poppins_black" android:gravity="center" android:text="Tunai" android:textColor="@color/brand_ink" android:textSize="13sp" android:textStyle="bold" />
                        <TextView android:id="@+id/btn_pay_saldo" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="7dp" android:layout_weight="1" android:background="@drawable/bg_activity_icon_well" android:clickable="true" android:focusable="true" android:fontFamily="@font/poppins_black" android:gravity="center" android:text="Saldo" android:textColor="@color/brand_ink" android:textSize="13sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/btn_confirm_ride"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_location_disabled"
        android:clickable="true"
        android:elevation="24dp"
        android:enabled="false"
        android:focusable="true">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/poppins_black"
            android:text="Selesaikan titik lokasi"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:textStyle="bold" />
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
