<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/brand_lavender"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="14dp"
    android:paddingEnd="20dp"
    android:paddingBottom="22dp">
    <View android:layout_width="46dp" android:layout_height="5dp" android:layout_gravity="center" android:layout_marginBottom="14dp" android:background="@color/black" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_activity_history_card" android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/chat_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/poppins_black" android:text="Chat" android:textColor="@color/brand_ink" android:textSize="19sp" android:textStyle="bold" />
        <ScrollView android:id="@+id/chat_scroll" android:layout_width="match_parent" android:layout_height="280dp" android:layout_marginTop="12dp" android:fillViewport="false" android:scrollbars="none"><LinearLayout android:id="@+id/chat_messages" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" /></ScrollView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:orientation="horizontal">
            <EditText android:id="@+id/chat_input" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="8dp" android:layout_weight="1" android:background="@drawable/bg_profile_sheet_input" android:fontFamily="@font/poppins_bold" android:hint="Tulis pesan..." android:inputType="textCapSentences" android:maxLines="4" android:paddingHorizontal="14dp" android:textColor="@color/brand_ink" android:textColorHint="@color/text_muted" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:clickable="true" android:focusable="true" android:gravity="center" android:id="@+id/btn_send" android:layout_width="92dp" android:layout_height="match_parent" android:background="@drawable/bg_location_primary_teal" android:fontFamily="@font/poppins_black" android:text="Kirim" android:textAllCaps="false" android:textColor="@color/brand_ink" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
